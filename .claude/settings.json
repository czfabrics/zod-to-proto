{
    "$schema": "https://json.schemastore.org/claude-code-settings.json",
    "theme": "dark",
    "disableClaudeAiConnectors": true,
    "autoMode": {
        "environment": [
            "$defaults",
            "Network posture: Claude Code runs as a non-root user inside a container whose egress goes through a domain-allowlisting proxy."
        ],
        "allow": ["$defaults"],
        "soft_deny": [
            "$defaults",
            "Do not modify bun.lock; lock updates go through a reviewed PR."
        ],
        "hard_deny": ["$defaults", "Never run npm publish or npm adduser."]
    },
    "skipDangerousModePermissionPrompt": true,
    "sandbox": {
        "enabled": true,
        "autoAllowBashIfSandboxed": true,
        "excludedCommands": ["curl *", "wget *", "nix-shell *"],
        "filesystem": {
            "allowWrite": ["/nix", "/tmp", "~/.cache"],
            "denyWrite": ["./.claude/settings.json", "./.claude/settings.local.json"]
        },
        "credentials": {
            "envVars": [{ "name": "CLAUDE_CODE_OAUTH_TOKEN", "mode": "deny" }]
        }
    },
    "permissions": {
        "defaultMode": "acceptEdits",
        "allow": [
            "Bash(ls:*)",
            "Bash(pwd)",
            "Bash(cd:*)",
            "Bash(cat:*)",
            "Bash(head:*)",
            "Bash(tail:*)",
            "Bash(wc:*)",
            "Bash(grep:*)",
            "Bash(rg:*)",
            "Bash(sed:*)",
            "Bash(awk:*)",
            "Bash(find:*)",
            "Bash(fd:*)",
            "Bash(tree:*)",
            "Bash(sort:*)",
            "Bash(uniq:*)",
            "Bash(cut:*)",
            "Bash(tr:*)",
            "Bash(seq:*)",
            "Bash(diff:*)",
            "Bash(comm:*)",
            "Bash(file:*)",
            "Bash(stat:*)",
            "Bash(du:*)",
            "Bash(df:*)",
            "Bash(echo:*)",
            "Bash(printf:*)",
            "Bash(basename:*)",
            "Bash(dirname:*)",
            "Bash(realpath:*)",
            "Bash(readlink:*)",
            "Bash(which:*)",
            "Bash(date:*)",
            "Bash(test:*)",
            "Bash(true)",
            "Bash(false)",
            "Bash(tee:*)",
            "Bash(xargs:*)",
            "Bash(jq:*)",
            "Bash(yq:*)",
            "Bash(md5sum:*)",
            "Bash(sha256sum:*)",
            "Bash(mkdir:*)",
            "Bash(touch:*)",
            "Bash(cp:*)",
            "Bash(mv:*)",
            "Bash(ln:*)",
            "Bash(chmod:*)",
            "Bash(rm:*)",
            "Bash(tar:*)",
            "Bash(gzip:*)",
            "Bash(gunzip:*)",

            "Bash(bash:*)",
            "Bash(sh:*)",
            "Bash(env:*)",

            "Bash(git status:*)",
            "Bash(git diff:*)",
            "Bash(git log:*)",
            "Bash(git show:*)",
            "Bash(git blame:*)",
            "Bash(git branch:*)",
            "Bash(git switch:*)",
            "Bash(git checkout:*)",
            "Bash(git restore:*)",
            "Bash(git add:*)",
            "Bash(git commit:*)",
            "Bash(git stash:*)",
            "Bash(git worktree:*)",
            "Bash(git rev-parse:*)",
            "Bash(git ls-files:*)",
            "Bash(git config --get:*)",

            "Bash(python3:*)",
            "Bash(pip3 list:*)",
            "Bash(node:*)",
            "Bash(perl:*)",
            "Bash(bun run:*)",
            "Bash(bun test:*)",
            "Bash(cargo build:*)",
            "Bash(cargo check:*)",
            "Bash(cargo test:*)",
            "Bash(cargo clippy:*)",
            "Bash(cargo fmt:*)",
            "Bash(rustc --version)",
            "Bash(makers:*)",
            "Bash(cargo make:*)",

            "Bash(treefmt:*)",
            "Bash(nixpkgs-fmt:*)",
            "Bash(yamlfmt:*)",
            "Bash(beautysh:*)",
            "Bash(prettier:*)",
            "Bash(eslint:*)",
            "Bash(vitest:*)",
            "Bash(bashly:*)",

            "Bash(terraform init:*)",
            "Bash(terraform validate:*)",
            "Bash(terraform fmt:*)",
            "Bash(terraform version:*)",
            "Bash(terraform --version)",

            "Bash(nix-shell:*)",
            "Bash(nix fmt:*)",
            "Bash(nix eval:*)",
            "Bash(nix derivation show:*)",
            "Bash(nix flake show:*)",
            "Bash(nix flake metadata:*)",
            "Bash(nix-instantiate:*)",
            "Bash(nix --version)",

            "Bash(curl:*)",
            "Bash(wget:*)",
            "WebFetch",
            "WebSearch",

            "Read",
            "Glob",
            "Grep"
        ],
        "ask": [],
        "deny": [
            "Bash(terraform apply:*)",
            "Bash(terraform plan:*)",
            "Bash(terraform destroy:*)",
            "Bash(terraform import:*)",
            "Bash(terraform state:*)",
            "Bash(terraform refresh:*)",
            "Bash(terraform taint:*)",
            "Bash(terraform untaint:*)",
            "Bash(terraform output:*)",
            "Bash(terraform login:*)",
            "Bash(terraform workspace:*)",

            "Bash(nix flake update:*)",
            "Bash(nix flake lock:*)",
            "Bash(nix flake init:*)",
            "Bash(nix flake new:*)",
            "Bash(nix flake clone:*)",
            "Bash(nix flake archive:*)",
            "Bash(nix flake check:*)",
            "Bash(nix registry:*)",
            "Bash(nix profile:*)",
            "Bash(nix upgrade-nix:*)",
            "Bash(nix-channel:*)",
            "Bash(nix-env:*)",
            "Bash(nix build:*)",
            "Bash(nix run:*)",
            "Bash(nix shell:*)",
            "Bash(nix develop:*)",
            "Bash(nix copy:*)",
            "Bash(nix store:*)",
            "Bash(nix search:*)",
            "Bash(nix-build:*)",
            "Bash(nix-collect-garbage:*)",
            "Bash(nixos-rebuild:*)",

            "Bash(sops:*)",
            "Bash(gpg:*)",
            "Bash(ssh:*)",
            "Bash(scp:*)",
            "Bash(ssh-keyscan:*)",
            "Bash(ssh-to-age:*)",
            "Bash(kubectl:*)",
            "Bash(kdash:*)",
            "Bash(docker:*)",

            "Bash(git push:*)",
            "Bash(git remote:*)",
            "Bash(git reset --hard:*)",
            "Bash(git clean:*)",

            "Bash(sudo:*)",

            "Edit(**/flake.lock)",
            "Edit(**/.nix-channels)",
            "Edit(**/.claude/settings.json)",
            "Edit(**/.claude/settings.local.json)",

            "Read(//home/claude/config/**)",
            "Edit(//home/claude/config/**)",
            "Read(**/.env*)",
            "Edit(**/.env*)",
            "Read(**/secrets/**)",
            "Edit(**/secrets/**)",
            "Read(**/*.kubeconfig.yaml)",
            "Edit(**/*.kubeconfig.yaml)",
            "Read(**/terraform.tfstate*)",
            "Edit(**/terraform.tfstate*)"
        ],
        "additionalDirectories": [
            "/tmp",
            "/home/claude",
            "/nix/store",
            "/etc/claude/nixpkgs"
        ]
    }
}
